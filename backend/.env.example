# 在等号后面填写 DeepSeek API Key，不要加引号。
# 复制本文件为 backend/.env 后再填写。不要把 .env 提交到 Git，也不要发到聊天里。
DEEPSEEK_API_KEY=

# L2 Inference Service（相对项目根目录）
L2_INFERENCE_ENABLED=1
L2_EQUIPMENT_TYPE=main_mill_motor
L2_MODEL_BUNDLE_ID=TR-0b062172078e
L2_MODEL_BUNDLE_PATH=models/main_mill_motor/TR-0b062172078e
L2_MAX_BATCH_SIZE=200
L2_CLEAR_PROBABILITY_THRESHOLD=0.80
L2_FAULT_TOP1_THRESHOLD=0.70
L2_MAX_PROBABILITY_GAP=0.20

# L2 Management（写操作必须配置 Token；未配置时拒绝训练/激活/回滚）
L2_MANAGEMENT_TOKEN=
L2_MANAGEMENT_DB=backend/data/l2_management.sqlite3
L2_TRAINING_LOGS_ROOT=backend/data/l2_training_logs
L2_MODELS_ROOT=models
L2_WORKER_POLL_INTERVAL=2

# L1→L2 PreparedEquipmentDataset 快照根目录（相对项目根或绝对路径）
# L2_PREPARED_ROOT=data/runtime/l2_prepared
